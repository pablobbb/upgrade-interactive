{
  "name": "upgrade-interactive",
  "version": "2.2.0",
  "description": "An interactive dependency upgrader for npm projects, inspired by `yarn upgrade-interactive` (Yarn Berry / Yarn 4), with built-in vulnerability warnings.",
  "type": "module",
  "bin": {
    "upgrade-interactive": "src/cli.js",
    "nui": "src/cli.js"
  },
  "main": "./src/cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablobbb/upgrade-interactive.git"
  },
  "homepage": "https://github.com/pablobbb/upgrade-interactive#readme",
  "bugs": {
    "url": "https://github.com/pablobbb/upgrade-interactive/issues"
  },
  "scripts": {
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node test/app.test.mjs && node --test test/integration/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "!src/types.d.ts",
    "CHANGELOG.md"
  ],
  "keywords": [
    "npm",
    "yarn",
    "upgrade-interactive",
    "upgrade",
    "update",
    "dependencies",
    "devdependencies",
    "outdated",
    "npm-outdated",
    "dependency-management",
    "package-manager",
    "semver",
    "vulnerability",
    "vulnerabilities",
    "audit",
    "npm-audit",
    "security",
    "overrides",
    "cli",
    "tui",
    "terminal",
    "interactive"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.8.0",
    "ink-testing-library": "^4.0.0",
    "string-width": "^7.2.0",
    "typescript": "^7.0.2"
  }
}
