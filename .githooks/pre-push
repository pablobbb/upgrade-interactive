#!/bin/sh
# Refuse a push that would publish secrets or personal data (scripts/check-sensitive.mjs).
# Enable once per clone:   git config core.hooksPath .githooks
# Skip once, knowingly:    git push --no-verify
#
# git passes one line per ref on stdin: <local ref> <local oid> <remote ref> <remote oid>.
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue   # a branch deletion publishes nothing
  if [ "$remote_oid" = "$zero" ]; then
    range="$local_oid --not --remotes=$remote"   # a new branch: what the remote doesn't have yet
  else
    range="$remote_oid..$local_oid"
  fi
  # shellcheck disable=SC2086
  node "$(git rev-parse --show-toplevel)/scripts/check-sensitive.mjs" --commits $range || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: refused. Fix the commits above (git commit --amend, or git rebase -i), then push again." >&2
fi
exit $status
