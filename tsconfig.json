{
  // Type-checks the JavaScript sources from their JSDoc annotations. Nothing is
  // compiled: the package ships `src/` as written (see `files`), so `tsc` is a
  // checker only. Run it with `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node 18 is the `engines` floor, so its types flag any newer API.
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/types.d.ts",
    "src/flags.js",
    "src/icons.js",
    "src/links.js",
    "src/lockfile.js",
    "src/override-keys.js",
    "src/override-select.js",
    "src/package-file.js",
    "src/registry.js",
    "src/semver-suggest.js",
    "src/workspaces.js"
  ]
}
